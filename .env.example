# Clash of Clans API key from https://developer.clashofclans.com
# Create the key with the allowed IP 45.79.218.79 (RoyaleAPI's free proxy),
# because Vercel servers don't have a fixed IP address.
COC_API_TOKEN=
# Optional. Defaults to the RoyaleAPI proxy. Use https://api.clashofclans.com/v1
# only if your server has a fixed IP that you put on the key.
COC_API_BASE=

# Admins who can draw the bracket and enter results: name:password pairs.
ADMINS=Sagar:change-me,Friend:change-me-too
# Optional. Signs admin sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Upstash Redis, supplied by the Vercel integration (either naming works).
# Without these, local development stores data in .data/clancup.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
