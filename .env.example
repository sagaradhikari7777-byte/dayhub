# PostgreSQL option: URL from Neon or Supabase (pooled connection).
# Leave empty when using the existing Upstash database instead.
DATABASE_URL=
# Alternatively connect the existing together-db Upstash integration to DayHub.
# These values are supplied by Vercel when you connect the database.
# auto selects PostgreSQL when DATABASE_URL exists, otherwise Upstash when connected.
# Use upstash explicitly if the project has variables for more than one provider.
DAYHUB_STORAGE=auto
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy Vercel integrations may supply KV_REST_API_URL / KV_REST_API_TOKEN instead.
# Generate with: openssl rand -hex 32. Recommended; required for PostgreSQL on Vercel.
# With Upstash and no explicit value, a signing key is derived from its server-only token.
# Rotating the token then invalidates anonymous sessions; set a stable value first.
SESSION_SECRET=
# Protects /api/cron/prices. Vercel sends this as a Bearer token.
CRON_SECRET=
# Optional automatic discovery of Australian store offers (SerpApi Google Shopping).
# The key stays server-side. This is separate from direct store price checks.
# Requires the connected Upstash database for shared caching and a daily budget.
SERPAPI_API_KEY=
# Maximum uncached provider requests per UTC day, shared across this deployment.
# Check your provider plan before enabling. No account or subscription is created by DayHub.
COMPARISON_DAILY_LIMIT=10
# Demo records only on explicit opt-in in production.
NEXT_PUBLIC_DEMO_MODE=false

# Optional web push. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
